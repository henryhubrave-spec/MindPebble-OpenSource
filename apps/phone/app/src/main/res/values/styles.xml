<resources>
    <color name="paper">#FAF7F5</color>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B07261</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FAF7F5</item>
        <item name="android:navigationBarColor">#FAF7F5</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:alertDialogTheme">@style/FlatDialog</item>
        <item name="android:datePickerDialogTheme">@style/FlatDialog</item>
        <item name="android:timePickerDialogTheme">@style/FlatDialog</item>
    </style>
    <style name="FlatDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_flat</item>
        <item name="android:windowElevation">8dp</item>
        <item name="android:windowAnimationStyle">@style/PebbleDialogMotion</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:colorAccent">#B07261</item>
        <item name="android:colorControlActivated">#46645D</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:buttonBarButtonStyle">@style/FlatDialogButton</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorBackground">#FFFCFA</item>
    </style>
    <style name="FlatDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item><item name="android:textColor">#B07261</item>
        <item name="android:minHeight">48dp</item><item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item><item name="android:textSize">14sp</item>
    </style>
    <style name="PebbleDialogMotion"><item name="android:windowEnterAnimation">@anim/dialog_enter</item><item name="android:windowExitAnimation">@anim/dialog_exit</item></style>
</resources>
